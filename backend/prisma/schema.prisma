generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  parent
  child
  admin
}

enum Sex {
  male
  female
}

enum TransactionType {
  earn
  spend
}

enum TransactionStatus {
  pending
  approved
  rejected
}

enum GoalStatus {
  active
  completed
  cancelled
}

enum ChoreStatus {
  assigned
  completed
}

model User {
  id                   String                  @id @db.Uuid
  fullName             String?
  nin                  String?                 @unique
  phoneNumber          String?                 @unique
  email                String                  @unique
  sex                  Sex?
  profileImageUrl      String?                 @db.Text
  isActive             Boolean                 @default(true)
  deactivatedAt        DateTime?
  role                 Role
  accountBalance       Float                   @default(0)
  totalDeposited       Float                   @default(0)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  parentChildren       ChildProfile[]          @relation("ParentChildren")
  childProfile         ChildProfile?           @relation("ChildUser")
  createdChores        ChoreAssignment[]       @relation("ParentAssignedChores")
  allowanceSchedules   AllowanceSchedule[]     @relation("ParentAllowanceSchedules")
  approvedTransactions Transaction[]           @relation("ApproverTransactions")
  lessons              Lesson[]
  quizzes              Quiz[]
  parentSettings       ParentSettings?
  supportTickets       SupportTicket[]
  dashboardActionLogs  DashboardActionLog[]
  notificationReads    NotificationRead[]
  parentDeposits       ParentDeposit[]
  lessonAssignments    ChildLessonAssignment[] @relation("ParentLessonAssignments")
}

model ChildProfile {
  id                 String                  @id @default(cuid())
  nickname           String
  age                Int
  parentId           String                  @db.Uuid
  childUserId        String                  @unique @db.Uuid
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  parent             User                    @relation("ParentChildren", fields: [parentId], references: [id], onDelete: Cascade)
  childUser          User                    @relation("ChildUser", fields: [childUserId], references: [id], onDelete: Cascade)
  wallet             Wallet?
  savingsGoals       SavingsGoal[]
  budgets            Budget[]
  achievements       Achievement[]
  transactions       Transaction[]
  chores             ChoreAssignment[]
  allowanceSchedules AllowanceSchedule[]
  lessonAssignments  ChildLessonAssignment[]
}

model ChoreAssignment {
  id           String       @id @default(cuid())
  title        String
  description  String?
  rewardAmount Float        @default(2000)
  dueDate      DateTime?
  status       ChoreStatus  @default(assigned)
  completedAt  DateTime?
  childId      String
  parentId     String       @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  parent       User         @relation("ParentAssignedChores", fields: [parentId], references: [id], onDelete: Cascade)
}

model AllowanceSchedule {
  id          String       @id @default(cuid())
  title       String
  amount      Float
  availableOn DateTime
  notes       String?
  isActive    Boolean      @default(true)
  childId     String
  parentId    String       @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  parent      User         @relation("ParentAllowanceSchedules", fields: [parentId], references: [id], onDelete: Cascade)
}

model Wallet {
  id           String        @id @default(cuid())
  childId      String        @unique
  balance      Float         @default(0)
  totalEarned  Float         @default(0)
  totalSpent   Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  child        ChildProfile  @relation(fields: [childId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id               String            @id @default(cuid())
  walletId         String
  childId          String
  amount           Float
  type             TransactionType
  status           TransactionStatus @default(pending)
  description      String?
  withdrawalSource String?
  savingsGoalId    String?
  approvedById     String?           @db.Uuid
  reviewedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  wallet           Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  child            ChildProfile      @relation(fields: [childId], references: [id], onDelete: Cascade)
  approvedBy       User?             @relation("ApproverTransactions", fields: [approvedById], references: [id])
}

model SavingsGoal {
  id            String       @id @default(cuid())
  childId       String
  title         String
  targetAmount  Float
  currentAmount Float        @default(0)
  status        GoalStatus   @default(active)
  targetDate    DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  child         ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Budget {
  id           String       @id @default(cuid())
  childId      String
  monthlyLimit Float
  periodType   BudgetPeriod @default(monthly)
  isActive     Boolean      @default(true)
  periodStart  DateTime     @default(now())
  periodEnd    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
}

enum BudgetPeriod {
  weekly
  monthly
  quarterly
}

model Achievement {
  id          String       @id @default(cuid())
  childId     String
  title       String
  description String?
  points      Int          @default(0)
  unlockedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Lesson {
  id           String                  @id @default(cuid())
  title        String
  content      String
  resourceType String                  @default("text")
  resourceUrl  String?
  fileName     String?
  isPublished  Boolean                 @default(false)
  createdById  String                  @db.Uuid
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  createdBy    User                    @relation(fields: [createdById], references: [id], onDelete: Cascade)
  assignments  ChildLessonAssignment[]
}

model ChildLessonAssignment {
  id              String       @id @default(cuid())
  parentId        String       @db.Uuid
  childId         String
  lessonId        String
  status          String       @default("assigned")
  progressPercent Int          @default(0)
  studyDays       Int          @default(7)
  studyStartAt    DateTime?
  studyEndAt      DateTime?
  firstViewedAt   DateTime?
  lastViewedAt    DateTime?
  completedAt     DateTime?
  assignedAt      DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  parent          User         @relation("ParentLessonAssignments", fields: [parentId], references: [id], onDelete: Cascade)
  child           ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  lesson          Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([childId, lessonId])
  @@index([parentId, assignedAt])
}

model Quiz {
  id          String   @id @default(cuid())
  title       String
  isPublished Boolean  @default(false)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model ParentSettings {
  id                         String   @id @default(cuid())
  parentId                   String   @unique @db.Uuid
  withdrawalApprovalRequired Boolean  @default(true)
  accountFreezeEnabled       Boolean  @default(false)
  merchantRestrictions       String?
  quietHours                 String?
  notifyDeposits             Boolean  @default(true)
  notifyWithdrawals          Boolean  @default(true)
  notifySuspiciousLogins     Boolean  @default(true)
  notifyGoals                Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  parent                     User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id        String   @id @default(cuid())
  parentId  String   @db.Uuid
  issueType String
  message   String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model DashboardActionLog {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  role      Role
  dashboard String
  action    String
  metadata  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationRead {
  id             String   @id @default(cuid())
  userId         String   @db.Uuid
  notificationId String
  readAt         DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
}

model ParentDeposit {
  id        String   @id @default(cuid())
  parentId  String   @db.Uuid
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    User     @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, createdAt])
}
